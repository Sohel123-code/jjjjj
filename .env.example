VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=polygon-6628c.firebaseapp.com
# Active frontend: Supabase. Firebase fields are retained for the legacy emulator.
# Never put a service-role key or database password in a VITE variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_PROJECT_ID=polygon-6628c
VITE_FIREBASE_STORAGE_BUCKET=polygon-6628c.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=false
VITE_RECAPTCHA_SITE_KEY=
# GROQ_API_KEY is a Firebase Functions secret, NEVER a VITE variable.

# Public HTTPS endpoint on the campus LAN; never a public tunnel.
VITE_LAN_GATEWAY_URL=
# Gateway-only secrets belong on the LAN server, never in VITE variables.
# LAN_NETWORKS=[{"id":"...","zoneId":"...","secret":"...","cidrs":["192.168.10.0/24"]}]
# LAN_ALLOWED_ORIGINS=https://your-polygon-site.example
# LAN_BIND_HOST=192.168.10.5
# LAN_TLS_CERT=C:/secure/campus.crt
# LAN_TLS_KEY=C:/secure/campus.key
